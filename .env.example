# ThreatWatch configuration. Copy to .env and adjust.
# Every variable is optional; defaults are shown.

# --- Core --------------------------------------------------------------------
# SQLite by default. For PostgreSQL: postgresql+psycopg://user:pass@host/threatwatch
TW_DATABASE_URL=sqlite:///./data/threatwatch.db
TW_HOST=127.0.0.1
TW_PORT=8000
# When set, every /api and /taxii2 request needs header "X-API-Key: <value>"
# (or ?api_key=<value> for download links). Strongly recommended if exposed.
TW_API_KEY=
# Browser sign-in. Create users with: threatwatch user add <name> --role admin
TW_SESSION_IDLE_HOURS=12
TW_SESSION_MAX_DAYS=7
# auto | true | false - set true when serving through a TLS reverse proxy
TW_SESSION_COOKIE_SECURE=auto
TW_LOGIN_MAX_FAILURES=5
TW_LOG_LEVEL=INFO
# Runtime data directory (synced ATT&CK catalogue)
TW_DATA_DIR=./data

# --- Outbound HTTP -------------------------------------------------------------
TW_HTTP_TIMEOUT=20
# Optional corporate proxy for all outbound requests, e.g. http://proxy:3128
TW_HTTP_PROXY=
# Tor SOCKS proxy for .onion sources, e.g. socks5://127.0.0.1:9050
TW_TOR_PROXY=
# Comma-separated .onion pages (forums, leak-site indexes) to keyword-monitor via Tor
TW_ONION_SOURCES=

# --- Dark web / leak integrations (optional, free/trial keys) -------------------
TW_HIBP_API_KEY=
TW_INTELX_API_KEY=
# free.intelx.io for free keys, 2.intelx.io for paid
TW_INTELX_API_URL=https://free.intelx.io
TW_GITHUB_TOKEN=

# --- Threat intel feed keys (optional) -------------------------------------------
# One abuse.ch Auth-Key unlocks ThreatFox, URLhaus and MalwareBazaar (https://auth.abuse.ch/)
TW_ABUSECH_AUTH_KEY=
TW_OTX_API_KEY=
TW_ABUSEIPDB_API_KEY=
# Max indicators ingested per feed per run (protects SQLite from huge lists)
TW_FEED_MAX_ITEMS=20000
# Indicators not seen for this many days are marked inactive
TW_IOC_RETENTION_DAYS=90

# --- Scheduler -------------------------------------------------------------------
TW_SCHEDULER_ENABLED=true
TW_FEEDS_INTERVAL_MINUTES=60
TW_DARKWEB_INTERVAL_HOURS=24
TW_PHISHING_INTERVAL_HOURS=24
# 0 disables scheduled ASM scans (recommended: trigger manually / via cron)
TW_ASM_INTERVAL_HOURS=0

# --- Alerting --------------------------------------------------------------------
# Minimum severity that creates an alert: info|low|medium|high|critical
TW_ALERT_MIN_SEVERITY=medium
# Slack/Teams/Mattermost-compatible incoming webhook (JSON {"text": ...})
TW_ALERT_WEBHOOK_URL=

# --- Anti-phishing ---------------------------------------------------------------
TW_PHISHING_MAX_PERMUTATIONS=1500

# --- Attack surface management ---------------------------------------------------
# Active checks = TCP port scan, sensitive-path probes, DNS zone transfer.
# Only scan assets you own or are authorised to test.
TW_ASM_ACTIVE_DEFAULT=false
TW_ASM_MAX_HOSTS=150
TW_ASM_CONCURRENCY=200
